# VideoForge reads process environment variables directly; it does not
# automatically load this file. Set real local values in your shell or
# process environment, and never commit those values.

# Optional fallback for the Manbo TTS API. The local TTS settings UI may
# also store this secret in the ignored tts_settings.json file.
MANBO_API_KEY=

# Optional override for the JianYing draft directory.
JIANYING_DRAFT_DIR=

# Base URL used by the vforge CLI and MCP client.
VFORGE_BASE=http://localhost:8000
